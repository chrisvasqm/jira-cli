{
  "name": "jira-cli",
  "version": "0.1.0",
  "description": "Small Jira CLI for humans and agents",
  "type": "module",
  "bin": { "jira": "./dist/index.js" },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm build"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": { "name": "pnpm", "version": "^11.22.0", "onFail": "download" }
  },
  "dependencies": {
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
